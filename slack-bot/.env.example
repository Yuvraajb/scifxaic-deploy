# -------------------------------------------------------
# SCIF Slack Bot — environment variable template
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to git.
#
# The bot is now a command surface only (no polling/classifying). It needs Slack
# Socket Mode tokens plus the Supabase service_role key to read/write the
# subscriptions table. HIGH_ALERT posting lives in the Node worker (mvp/).
# -------------------------------------------------------

# Bot token (starts with xoxb-)
# Found in: Slack App dashboard > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-token-here

# App-level token for Socket Mode (starts with xapp-)
# Found in: Slack App dashboard > Basic Information > App-Level Tokens
SLACK_APP_TOKEN=xapp-your-token-here

# Supabase — server worker (service_role bypasses RLS; never expose to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

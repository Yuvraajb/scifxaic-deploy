# SCIF classification worker — environment template.
# Copy to mvp/.env and fill in. On Render these are injected by the dashboard.

# Finnhub (news source)
FINNHUB_API_KEY=

# LLM (classification agent)
OPENAI_API_KEY=
LLM_MODEL=gpt-5.5

# Schedule is fixed in code: 3 pulls/weekday at 08:30, 13:00, 16:30 ET (run.js).

# Supabase — server worker (service_role bypasses RLS; never expose to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Slack outbound (HIGH_ALERT posts). Bot token + target channel.
# Socket Mode / app-level token NOT needed for posting.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

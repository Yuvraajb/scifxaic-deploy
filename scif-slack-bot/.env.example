# -------------------------------------------------------
# SCIF Slack Bot — environment variable template
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to git.
# -------------------------------------------------------

# Bot token (starts with xoxb-)
# Found in: Slack App dashboard > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-token-here

# App-level token for Socket Mode (starts with xapp-)
# Found in: Slack App dashboard > Basic Information > App-Level Tokens
SLACK_APP_TOKEN=xapp-your-token-here

# Default channel to post alerts and digests
# Right-click a channel in Slack > View channel details > Copy channel ID
SLACK_CHANNEL_ID=your-channel-id-here

VITE_ANTHROPIC_API_KEY=
VITE_BENZINGA_TOKEN=
VITE_ENABLE_CAPITAL_IQ=false
VITE_POLL_INTERVAL_MS=300000

# Supabase — frontend (browser). Vite only exposes VITE_-prefixed vars.
# Anon/publishable key is browser-safe because RLS is enabled on every table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server workers (mvp Node, Slack bot Python). NOT exposed to browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
